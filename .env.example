# Root development environment template.
# Copy values into a local .env file only when needed. Do not commit real secrets.

APP_ENV=local
API_PORT=8080
MATH_VERIFIER_PORT=8090

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verified_ai
POSTGRES_USER=verified_ai_local
POSTGRES_PASSWORD=local_dev_password_change_me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=500ms

MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=minio_local_password_change_me
OBJECT_STORAGE_BUCKET=verified-ai-local

MATH_VERIFIER_INTERNAL_TOKEN=local_math_verifier_token_change_me
API_INTERNAL_TOKEN=local_api_internal_token_change_me

# Sign in with Apple / first-party auth.
# Do not commit real private keys. Local/test can omit access-token PEMs and use generated dev-only keys.
APPLE_CLIENT_ID=com.verifiedai.learning
APPLE_IDENTITY_ISSUER=https://appleid.apple.com
APPLE_JWK_SET_URI=https://appleid.apple.com/auth/keys
ACCESS_TOKEN_ISSUER=verified-ai-api
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
ACCESS_TOKEN_PRIVATE_KEY_PEM=
ACCESS_TOKEN_PUBLIC_KEY_PEM=

# Apple commerce. Keep disabled locally unless using StoreKit/App Store sandbox credentials.
APPLE_BILLING_ENABLED=false
APPLE_PURCHASE_AVAILABLE=false
APPLE_BILLING_ENVIRONMENT=XCODE
APPLE_BILLING_BUNDLE_ID=com.verifiedai.learning
APPLE_APP_APPLE_ID=0
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY_PEM=
APPLE_ROOT_CERTIFICATE_PEM=

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
