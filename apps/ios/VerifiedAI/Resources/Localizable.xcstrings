        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satıra bir adım, en fazla 12 satır. Çarpma için * ve gruplama için parantez kullanın. Desteklenmeyen gösterimler inceleme gerektirir."
          }
        }
      }
    },
