    "visualization.approximate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines join approximate samples within continuous branches. They do not prove roots or describe every detail between samples."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizgiler sürekli dallardaki yaklaşık örnekleri birleştirir. Kökleri kanıtlamaz veya örnekler arasındaki her ayrıntıyı göstermez."
          }
        }
      }
    },
