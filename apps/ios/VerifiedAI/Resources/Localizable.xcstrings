    "attempt.mistake.INVALID_TRANSFORMATION": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transformation changes the mathematical claim. A more specific mistake pattern was not proved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönüşüm matematiksel iddiayı değiştiriyor. Daha özel bir hata örüntüsü kanıtlanamadı."
          }
        }
      }
    },
    "attempt.mistake.ALG_SIGN_FLIP_DISTRIBUTE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minus sign must change both signs inside the parentheses. Distribute it to each term."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parantezin önündeki eksi içerideki her terimin işaretini değiştirmeli. Eksiyi her terime dağıt."
          }
        }
      }
    },
    "attempt.mistake.ALG_FRESHMAN_DREAM_POWER": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squaring a sum requires the cross term: (a+b)²=a²+2ab+b²."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplamın karesinde çapraz terim de gerekir: (a+b)²=a²+2ab+b²."
          }
        }
      }
    },
    "attempt.mistake.ALG_FRACTION_ADD_DENOM": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractions need a common denominator. Adding the denominators changes the value."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesirleri toplamak için ortak payda gerekir. Paydaları toplamak değeri değiştirir."
          }
        }
      }
    },
    "attempt.mistake.ALG_ROOT_LOST_BY_DIVISION": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividing by a variable factor removed a valid zero of that factor. Check its zero case separately."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişkenli çarpana bölmek, o çarpanın geçerli bir sıfırını kaybettirdi. Sıfır olduğu durumu ayrı incele."
          }
        }
      }
    },
    "attempt.mistake.DOM_EXTRANEOUS_ROOT_DENOM": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transformed equation admits a value that makes an original denominator zero. Check candidates in the original equation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni denklem, özgün paydasını sıfır yapan bir değeri kabul ediyor. Aday kökleri özgün denklemde kontrol et."
          }
        }
      }
    },
    "attempt.mistake.DOM_EVEN_ROOT_NEGATIVE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A principal real square root cannot equal a negative value. Squaring introduced an invalid root."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asal reel karekök negatif olamaz. Karesini almak geçersiz bir kök ekledi."
          }
        }
      }
    },
    "attempt.mistake.DOM_LOG_NON_POSITIVE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new roots include a nonpositive logarithm argument. A real logarithm needs a positive argument."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni köklerden biri logaritmanın içini sıfır veya negatif yapıyor. Reel logaritmanın içi pozitif olmalı."
          }
        }
      }
    },
    "attempt.mistake.INEQ_NEGATIVE_MULT_NO_FLIP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplication or division by a negative constant reverses the inequality."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Negatif bir sabitle çarpma veya bölme eşitsizliğin yönünü değiştirir."
          }
        }
      }
    },
    "attempt.mistake.INEQ_CROSS_MULT_VARIABLE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross multiplication by a variable denominator needs separate positive and negative cases."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişkenli paydayla çapraz çarpmadan önce pozitif ve negatif durumları ayrı incele."
          }
        }
      }
    },
    "attempt.mistake.ABS_SINGLE_BRANCH_ONLY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The absolute-value equation has another branch. Check both signs before selecting roots."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutlak değer denkleminin başka bir dalı da var. Kökleri seçmeden önce iki işareti de kontrol et."
          }
        }
      }
    },
    "attempt.mistake.FUNC_COMPOSITION_ORDER": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order of these functions changed. Evaluate the inner function first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fonksiyonların sırası değişti. Önce içteki fonksiyonu uygula."
          }
        }
      }
    },
    "attempt.mistake.TRIG_PERIOD_OMITTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A periodic root inside the stated interval was omitted. Include every allowed period."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirtilen aralıkta periyodik bir kök eksik. İzin verilen bütün periyotları dikkate al."
          }
        }
      }
    },
    "attempt.mistake.CALC_LIMIT_INDETERMINATE_SUB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0/0 is indeterminate, not zero. Simplify on a punctured neighborhood before taking the limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0/0 sıfır değil, belirsiz biçimdir. Limiti almadan önce noktanın delinmiş komşuluğunda sadeleştir."
          }
        }
      }
    },
    "attempt.mistake.CALC_CHAIN_RULE_OMITTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The derivative of the inner function is missing. Multiply by that derivative."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İç fonksiyonun türevi eksik. Onun türeviyle de çarp."
          }
        }
      }
    },
    "attempt.mistake.CALC_PRODUCT_QUOTIENT_NAIVE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivatives cannot simply be multiplied or divided. Apply the product or quotient rule."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türevler doğrudan çarpılamaz veya bölünemez. Çarpım ya da bölüm kuralını uygula."
          }
        }
      }
    },
    "attempt.mistake.CALC_INTEGRAL_BOUNDS_SWAPPED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reversing the integration bounds changes the sign of the integral."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İntegral sınırlarını ters çevirmek integralin işaretini değiştirir."
          }
        }
      }
    },
    "attempt.mistake.WORD_VARIABLE_MISASSIGNMENT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assigned quantity conflicts with the explicit variable definition. Match the variable to the stated quantity and unit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atanan nicelik, değişkenin açık tanımıyla uyuşmuyor. Değişkeni belirtilen nicelik ve birimle eşleştir."
          }
        }
      }
    },
