    "attempt.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one statement per line. Confirm the real-number scope when appropriate. Unsupported or ambiguous mathematics remains uncertain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satıra bir matematiksel ifade gir. Uygunsa reel sayı kapsamını onayla. Desteklenmeyen veya belirsiz matematik için kesin hüküm verilmez."
          }
        }
      }
    },
    "attempt.handwriting.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
