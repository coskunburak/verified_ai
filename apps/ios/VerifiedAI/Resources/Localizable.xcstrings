            "value": "Metinden cebire"
          }
        }
      }
    },
    "visualization.feature.ROOT_INTERCEPT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact root / x intercept"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin kök / x ekseni kesişimi"
          }
        }
      }
    },
    "visualization.feature.Y_INTERCEPT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact y intercept"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin y ekseni kesişimi"
          }
        }
      }
    },
    "visualization.feature.QUADRATIC_VERTEX": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadratic vertex (x also gives the symmetry axis)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parabolün tepe noktası (x, simetri eksenini de verir)"
          }
        }
      }
    },
    "visualization.feature.SLOPE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slope (second coordinate)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğim (ikinci koordinat)"
          }
        }
      }
    },
    "visualization.concept.APPROXIMATE_SAMPLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samples are approximate display data, not mathematical evidence."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnekler yaklaşık gösterim verisidir, matematiksel kanıt değildir."
          }
        }
      }
    },
    "visualization.concept.ROOT_INTERCEPT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exact root makes the plotted function or equation residual zero within the source domain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin kök, kaynak tanım kümesinde fonksiyonu veya denklem farkını sıfır yapar."
          }
        }
      }
    },
    "visualization.concept.POSITIVE_SLOPE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The affine model has positive slope."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrusal modelin eğimi pozitiftir."
          }
        }
      }
    },
    "visualization.concept.NEGATIVE_SLOPE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The affine model has negative slope."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrusal modelin eğimi negatiftir."
          }
        }
      }
    },
    "visualization.concept.ZERO_DERIVATIVE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ambient function has zero derivative on its natural domain. Restriction endpoints do not assert a two-sided derivative."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonksiyonun doğal tanım kümesindeki türevi sıfırdır. Kısıt uçlarında iki yönlü türev iddia edilmez."
          }
        }
      }
    },
    "visualization.concept.DOMAIN_HOLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded inputs remain excluded even if a denominator cancels. Separate branches are never connected across them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payda sadeleşse bile dışlanan girdiler dışarıda kalır. Ayrı dallar bu noktalardan birleştirilmez."
          }
        }
      }
    },
    "visualization.concept.QUADRATIC_VERTEX": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact vertex lies in the source domain. The unrestricted quadratic is symmetric about its x coordinate; restrictions may remove part of that graph."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin tepe noktası kaynak tanım kümesindedir. Kısıtsız parabol, bu x değerinde simetriktir; kısıtlar grafiğin bir bölümünü kaldırabilir."
          }
        }
      }
    },
    "visualization.concept.OPEN_BOUNDARY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open endpoint is excluded. Infinite ends are always open and extend outward."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık uç kümeye dahil değildir. Sonsuz uçlar her zaman açıktır ve dışarı uzanır."
          }
        }
      }
    },
    "visualization.concept.CLOSED_BOUNDARY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closed endpoint belongs to the set. A single closed point can be an isolated solution."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı uç kümeye dahildir. Tek kapalı nokta yalıtılmış çözüm olabilir."
          }
        }
      }
    },
    "attempt.methods.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified method cards are independently checked for the source problem. They do not verify your work or the generated solution."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış yöntem kartları kaynak soru için bağımsız kontrol edilir. Çalışmanızı veya üretilen çözümü doğrulamaz."
          }
        }
      }
    },
    "attempt.methods.source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source problem and conditions"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak soru ve koşullar"
          }
        }
