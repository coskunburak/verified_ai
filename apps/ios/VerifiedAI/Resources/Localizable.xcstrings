    "attempt.methods.step.NORMALIZE_ZERO": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move terms to one side and collect exact coefficients."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terimleri bir tarafa taşıyıp katsayıları tam olarak düzenleyin."
          }
        }
      }
    },
    "attempt.methods.step.ZERO_PRODUCT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exact factorization preserves the equation; a product is zero when a factor is zero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam çarpanlara ayırma denklemi korur; çarpanlardan biri sıfırsa çarpım sıfırdır."
          }
        }
      }
    },
    "attempt.methods.step.SQUARE_IDENTITY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide by the nonzero leading coefficient and add the same square term to both sides."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfır olmayan baş katsayıya bölüp iki tarafa aynı tamamlama terimini ekleyin."
          }
        }
      }
    },
    "attempt.methods.step.DISCRIMINANT_FORMULA": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use both signs of the square root in (−b ± √(b²−4ac))/(2a), with a ≠ 0."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "a ≠ 0 koşuluyla (−b ± √(b²−4ac))/(2a) ifadesinde kökün iki işaretini de kullanın."
          }
        }
      }
    },
    "attempt.methods.step.COMPLETE_REAL_SET": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect all real roots, remove repeats and apply the source conditions; the empty set means no real solution."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm gerçek kökleri toplayın, tekrarları kaldırın ve kaynak koşullarını uygulayın; boş küme gerçek çözüm olmadığını gösterir."
          }
        }
      }
    },
