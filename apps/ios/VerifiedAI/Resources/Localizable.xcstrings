    "visualization.chartSummary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate graph. Solid: function or equation residual. Dashed: derivative. Use sample buttons for accessible selection. Axes have no physical units."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık grafik. Düz çizgi: fonksiyon veya denklem farkı. Kesikli çizgi: türev. Erişilebilir seçim için örnek düğmelerini kullanın. Eksenler fiziksel birim içermez."
          }
        }
      }
    },
    "visualization.interval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact interval: %@. Round endpoints are excluded; square endpoints are included."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin aralık: %@. Yuvarlak uçlar hariç, köşeli uçlar dahildir."
          }
        }
      }
    },
    "visualization.provenance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phrase-to-algebra highlighting requires reviewed source mappings. This source does not contain that evidence."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metinden cebire vurgulama, incelenmiş kaynak eşlemeleri gerektirir. Bu kaynakta bu kanıt bulunmuyor."
          }
        }
      }
    },
    "visualization.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source or visualization type is outside the supported real rational model. Try the number line for a set or inequality."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak veya tür, desteklenen gerçek rasyonel modelin dışındadır. Küme veya eşitsizlik için sayı doğrusunu deneyin."
          }
        }
      }
    },
    "visualization.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection unavailable. Reconnect and reload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok. Bağlandıktan sonra yeniden yükleyin."
          }
        }
      }
    },
    "visualization.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed. Reload its current revision."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak değişti. Güncel sürümünü yeniden yükleyin."
          }
        }
      }
    },
    "visualization.unauthorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to this source is no longer available. Return to your account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynağa erişim artık yok. Hesabınıza geri dönün."
          }
        }
      }
    },
    "visualization.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualization is unavailable or the response could not be validated. Retry later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görselleştirme kullanılamıyor veya yanıt doğrulanamadı. Daha sonra yeniden deneyin."
          }
        }
      }
    },
