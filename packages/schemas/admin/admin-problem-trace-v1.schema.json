{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/admin/admin-problem-trace-v1.schema.json",
  "title": "AdminProblemTraceResponse",
  "description": "Default redacted problem trace view (strictly excludes objectKey, rawOutputJsonb, and normalizedProblemJsonb).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "problemSessionId",
    "userId",
    "sessionStatus",
    "inputMode",
    "currentParseId",
    "problemId",
    "solveJobId",
    "sessionCreatedAt",
    "sessionUpdatedAt",
    "sessionCompletedAt",
    "rawContentRedacted",
    "assets",
    "parseRevisions",
    "aiUsageRecords",
    "verificationRuns",
    "mistakeDisputes",
    "auditId",
    "generatedAt",
    "llmTokensUsed",
    "trainingEligible"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "admin-problem-trace-v1" },
    "problemSessionId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "sessionStatus": { "type": "string", "minLength": 2, "maxLength": 48 },
    "inputMode": { "type": "string", "minLength": 2, "maxLength": 32 },
    "currentParseId": { "type": ["string", "null"], "format": "uuid" },
    "problemId": { "type": ["string", "null"], "format": "uuid" },
    "solveJobId": { "type": ["string", "null"], "format": "uuid" },
    "sessionCreatedAt": { "type": "string", "format": "date-time" },
    "sessionUpdatedAt": { "type": "string", "format": "date-time" },
    "sessionCompletedAt": { "type": ["string", "null"], "format": "date-time" },
    "rawContentRedacted": { "type": "boolean", "const": true },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/RedactedAsset" }
    },
    "parseRevisions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/RedactedParse" }
    },
    "aiUsageRecords": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/AiUsageProvenance" }
    },
    "verificationRuns": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/VerificationRunSummary" }
    },
    "mistakeDisputes": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/MistakeDisputeSummary" }
    },
    "auditId": { "type": "string", "format": "uuid" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "llmTokensUsed": { "type": "integer", "const": 0 },
    "trainingEligible": { "type": "boolean", "const": false }
  },
  "$defs": {
    "RedactedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "sourceType",
        "assetKind",
        "status",
        "contentType",
        "sizeBytes",
        "imageWidth",
        "imageHeight",
        "pageCount",
        "retentionClass",
        "availableAt",
        "deletedAt",
        "createdAt"
      ],
      "properties": {
        "assetId": { "type": "string", "format": "uuid" },
        "sourceType": { "type": "string", "maxLength": 48 },
        "assetKind": { "type": "string", "maxLength": 48 },
        "status": { "type": "string", "maxLength": 32 },
        "contentType": { "type": ["string", "null"], "maxLength": 128 },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "imageWidth": { "type": ["integer", "null"], "minimum": 0 },
        "imageHeight": { "type": ["integer", "null"], "minimum": 0 },
        "pageCount": { "type": ["integer", "null"], "minimum": 0 },
        "retentionClass": { "type": ["string", "null"], "maxLength": 32 },
        "availableAt": { "type": ["string", "null"], "format": "date-time" },
        "deletedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "RedactedParse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parseId",
        "parseJobId",
        "revision",
        "source",
        "supportStatus",
        "unsupportedReason",
        "reviewRequired",
        "schemaVersion",
        "provider",
        "model",
        "routePolicyVersion",
        "promptId",
        "promptVersion",
        "fallbackUsed",
        "inputTokens",
        "outputTokens",
        "providerLatencyMs",
        "totalLatencyMs",
        "estimatedCostMicros",
        "createdAt"
      ],
      "properties": {
        "parseId": { "type": "string", "format": "uuid" },
        "parseJobId": { "type": ["string", "null"], "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "maxLength": 48 },
        "supportStatus": { "type": "string", "maxLength": 48 },
        "unsupportedReason": { "type": ["string", "null"], "maxLength": 240 },
        "reviewRequired": { "type": "boolean" },
        "schemaVersion": { "type": ["string", "null"], "maxLength": 64 },
        "provider": { "type": ["string", "null"], "maxLength": 64 },
        "model": { "type": ["string", "null"], "maxLength": 128 },
        "routePolicyVersion": { "type": ["string", "null"], "maxLength": 64 },
        "promptId": { "type": ["string", "null"], "maxLength": 64 },
        "promptVersion": { "type": ["string", "null"], "maxLength": 64 },
        "fallbackUsed": { "type": "boolean" },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "providerLatencyMs": { "type": ["integer", "null"], "minimum": 0 },
        "totalLatencyMs": { "type": ["integer", "null"], "minimum": 0 },
        "estimatedCostMicros": { "type": ["integer", "null"], "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AiUsageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usageRecordId",
        "operationId",
        "capability",
        "routePolicyVersion",
        "routeId",
        "provider",
        "model",
        "promptId",
        "promptVersion",
        "schemaVersion",
        "status",
        "failureClass",
        "retryable",
        "attemptCount",
        "fallbackUsed",
        "fallbackChain",
        "escalationReason",
        "cacheStatus",
        "inputTokenCount",
        "outputTokenCount",
        "estimatedCostMicros",
        "providerLatencyMs",
        "gatewayLatencyMs",
        "correlationId",
        "traceId",
        "createdAt",
        "completedAt"
      ],
      "properties": {
        "usageRecordId": { "type": "string", "format": "uuid" },
        "operationId": { "type": "string", "maxLength": 128 },
        "capability": { "type": "string", "maxLength": 64 },
        "routePolicyVersion": { "type": ["string", "null"], "maxLength": 64 },
        "routeId": { "type": ["string", "null"], "maxLength": 64 },
        "provider": { "type": ["string", "null"], "maxLength": 64 },
        "model": { "type": ["string", "null"], "maxLength": 128 },
        "promptId": { "type": ["string", "null"], "maxLength": 64 },
        "promptVersion": { "type": ["string", "null"], "maxLength": 64 },
        "schemaVersion": { "type": ["string", "null"], "maxLength": 64 },
        "status": { "type": "string", "maxLength": 48 },
        "failureClass": { "type": ["string", "null"], "maxLength": 128 },
        "retryable": { "type": ["boolean", "null"] },
        "attemptCount": { "type": ["integer", "null"], "minimum": 0 },
        "fallbackUsed": { "type": ["boolean", "null"] },
        "fallbackChain": { "type": ["string", "null"], "maxLength": 256 },
        "escalationReason": { "type": ["string", "null"], "maxLength": 240 },
        "cacheStatus": { "type": ["string", "null"], "maxLength": 48 },
        "inputTokenCount": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokenCount": { "type": ["integer", "null"], "minimum": 0 },
        "estimatedCostMicros": { "type": ["integer", "null"], "minimum": 0 },
        "providerLatencyMs": { "type": ["integer", "null"], "minimum": 0 },
        "gatewayLatencyMs": { "type": ["integer", "null"], "minimum": 0 },
        "correlationId": { "type": ["string", "null"], "maxLength": 64 },
        "traceId": { "type": ["string", "null"], "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "VerificationRunSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "solutionId",
        "canonicalProblemId",
        "problemParseId",
        "problemParseRevision",
        "canonicalRevision",
        "policyVersion",
        "capabilityVersion",
        "correlationId",
        "status",
        "createdAt"
      ],
      "properties": {
        "runId": { "type": "string", "format": "uuid" },
        "solutionId": { "type": "string", "format": "uuid" },
        "canonicalProblemId": { "type": "string", "format": "uuid" },
        "problemParseId": { "type": "string", "format": "uuid" },
        "problemParseRevision": { "type": "integer", "minimum": 1 },
        "canonicalRevision": { "type": "integer", "minimum": 1 },
        "policyVersion": { "type": "string", "maxLength": 64 },
        "capabilityVersion": { "type": "string", "maxLength": 64 },
        "correlationId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 48 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MistakeDisputeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disputeId",
        "attemptId",
        "classificationId",
        "replacementAttemptId",
        "stepIndex",
        "disputeType",
        "policyVersion",
        "createdAt"
      ],
      "properties": {
        "disputeId": { "type": "string", "format": "uuid" },
        "attemptId": { "type": "string", "format": "uuid" },
        "classificationId": { "type": ["string", "null"], "format": "uuid" },
        "replacementAttemptId": { "type": ["string", "null"], "format": "uuid" },
        "stepIndex": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
        "disputeType": { "type": "string", "maxLength": 32 },
        "policyVersion": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
