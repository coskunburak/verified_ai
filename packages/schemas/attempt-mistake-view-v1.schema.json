{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt-mistake-view-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "attempt-mistake-view-v1"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "NOT_CLASSIFIED",
        "COMPLETED",
        "STALE"
      ]
    },
    "historical": {
      "type": "boolean"
    },
    "creationEnabled": {
      "type": "boolean"
    },
    "classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/classification"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "status",
    "historical",
    "creationEnabled",
    "classification"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "$ref": "#/$defs/classification"
          }
        }
      },
      "else": {
        "properties": {
          "classification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "STALE"
          }
        }
      },
      "then": {
        "properties": {
          "historical": {
            "const": true
          }
        }
      }
    }
  ],
