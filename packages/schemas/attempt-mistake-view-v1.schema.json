          "type": "object",
          "additionalProperties": false,
          "properties": {
            "canonicalId": {
              "type": "string",
              "format": "uuid"
            },
            "canonicalRevision": {
              "type": "integer",
              "minimum": 1
            },
            "parseId": {
              "type": "string",
              "format": "uuid"
            },
            "parseRevision": {
              "type": "integer",
              "minimum": 1
