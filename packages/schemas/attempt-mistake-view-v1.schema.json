        "taxonomyVersion": {
          "const": "attempt-taxonomy-v2"
        },
        "categoryVersion": {
          "const": "mistake-category-v1"
        },
        "policyVersion": {
          "const": "evidence-classifier-v1"
        },
        "verifierVersion": {
          "const": "bounded-attempt-v2"
        },
        "firstWrongStepId": {
          "anyOf": [
