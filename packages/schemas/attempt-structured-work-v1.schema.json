{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt-structured-work-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "attempt-structured-work-v1"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "ownerId": {
      "type": "string",
      "format": "uuid"
    },
    "problemSessionId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "supersedesAttemptId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "normalizationVersion": {
      "const": "structured-canonical-v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "engine": {
      "enum": [
        "MANUAL",
        "NATIVE_VISION",
        "GATEWAY_RECOGNITION"
      ]
    },
    "provenance": {
      "enum": [
        "CLIENT_ATTESTED",
        "SERVER_RECORDED"
      ]
    },
    "captureId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "assetSessionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "recognitionJobId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96
        },
        {
          "type": "null"
        }
      ]
    },
    "promptVersion": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "minItems": 0,
      "maxItems": 12
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "contains": {
        "properties": {
          "role": {
            "const": "FINAL_ANSWER"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    },
    "trainingEligible": {
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "ownerId",
    "problemSessionId",
    "source",
    "revision",
    "supersedesAttemptId",
    "normalizationVersion",
    "createdAt",
    "engine",
    "provenance",
    "captureId",
    "assetSessionId",
    "recognitionJobId",
    "provider",
    "model",
    "promptVersion",
    "observations",
    "steps",
    "trainingEligible"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalId": {
          "type": "string",
          "format": "uuid"
        },
        "canonicalRevision": {
          "type": "integer",
          "minimum": 1
        },
        "parseId": {
          "type": "string",
          "format": "uuid"
        },
        "parseRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "canonicalId",
        "canonicalRevision",
        "parseId",
        "parseRevision"
      ]
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "rawText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "box": {
          "anyOf": [
            {
              "$ref": "#/$defs/box"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "rawText",
        "confidence",
        "box"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "role": {
          "enum": [
            "INTERMEDIATE",
            "FINAL_ANSWER",
            "AMBIGUOUS"
          ]
        },
        "originalText": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true
        },
        "normalizedStatement": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1800
            },
            {
              "type": "null"
            }
          ]
        },
        "normalizationStatus": {
          "enum": [
            "NORMALIZED",
            "UNSUPPORTED",
            "REVIEW_REQUIRED"
          ]
        },
        "reviewStatus": {
          "enum": [
            "CONFIRMED",
            "REQUIRED"
          ]
        }
      },
      "required": [
        "id",
        "index",
        "role",
        "originalText",
        "reviewedText",
        "observationIds",
        "normalizedStatement",
        "normalizationStatus",
        "reviewStatus"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "normalizationStatus": {
                "const": "NORMALIZED"
              }
            }
          },
          "then": {
            "properties": {
              "normalizedStatement": {
                "type": "string"
              },
              "reviewStatus": {
                "const": "CONFIRMED"
              }
            }
          },
          "else": {
            "properties": {
              "normalizedStatement": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reviewStatus": {
                "const": "REQUIRED"
              }
            }
          },
          "then": {
            "properties": {
              "normalizationStatus": {
                "const": "REVIEW_REQUIRED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "normalizationStatus": {
                "const": "REVIEW_REQUIRED"
              }
            }
          },
          "then": {
            "properties": {
              "reviewStatus": {
                "const": "REQUIRED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "AMBIGUOUS"
              }
            }
          },
          "then": {
            "properties": {
              "reviewStatus": {
                "const": "REQUIRED"
              },
              "normalizationStatus": {
                "const": "REVIEW_REQUIRED"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "MANUAL"
          }
        }
      },
      "then": {
        "properties": {
          "captureId": {
            "type": "null"
          },
          "assetSessionId": {
            "type": "null"
          },
          "recognitionJobId": {
            "type": "null"
          },
          "observations": {
            "maxItems": 0
          },
          "steps": {
            "items": {
              "properties": {
                "observationIds": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "NATIVE_VISION"
          }
        }
      },
      "then": {
        "properties": {
          "assetSessionId": {
            "type": "null"
          },
          "recognitionJobId": {
            "type": "null"
          },
          "captureId": {
            "type": "string",
            "format": "uuid"
          },
          "observations": {
            "minItems": 1
          },
          "steps": {
            "items": {
              "properties": {
                "observationIds": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "GATEWAY_RECOGNITION"
          }
        }
      },
      "then": {
        "properties": {
          "captureId": {
            "type": "null"
          },
          "assetSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "recognitionJobId": {
            "type": "string",
            "format": "uuid"
          },
          "observations": {
            "minItems": 1
          },
          "steps": {
            "items": {
              "properties": {
                "observationIds": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "GATEWAY_RECOGNITION"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "const": "SERVER_RECORDED"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "promptVersion": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "const": "CLIENT_ATTESTED"
          },
          "provider": {
            "type": "null"
          },
          "model": {
            "type": "null"
          },
          "promptVersion": {
            "type": "null"
          }
        }
      }
    }
  ]
}
