{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt-submission-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalId": {
          "type": "string",
          "format": "uuid"
        },
        "canonicalRevision": {
          "type": "integer",
          "minimum": 1
        },
        "parseId": {
          "type": "string",
          "format": "uuid"
        },
        "parseRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "canonicalId",
        "canonicalRevision",
        "parseId",
        "parseRevision"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 12
    },
    "realDomainConfirmed": {
      "type": "boolean"
    },
    "captureReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engine",
        "rawLines",
        "confirmed"
      ],
      "properties": {
        "schemaVersion": {
          "const": "attempt-capture-review-v1"
        },
        "engine": {
          "enum": [
            "NATIVE_VISION",
            "GATEWAY_RECOGNITION"
          ]
        },
        "rawLines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "confirmed": {
          "const": true
        },
        "assetSessionId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "recognitionJobId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  },
  "required": [
    "source",
    "steps"
  ]
}
