{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verified-ai-learning.example/canonical-problem.schema.json",
  "title": "CanonicalProblem",
  "description": "Sprint 4.6 durable Layer 4 mathematical representation created from an accepted ProblemParse. It is not a solution, verification verdict, skill classification, or difficulty estimate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceParse",
    "subjectId",
    "topicId",
    "problemType",
    "taskType",
    "variables",
    "statements",
    "sourceConstraints",
    "sourceAssumptions",
    "derivedRestrictions",
    "complexityPolicy",
    "display"
  ],
  "properties": {
    "schemaVersion": {
      "const": "canonical-problem-v1"
    },
    "sourceParse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problemParseId", "problemParseRevision", "problemParseSchemaVersion", "source"],
      "properties": {
        "problemParseId": {"type": "string", "format": "uuid"},
        "problemParseRevision": {"type": "integer", "minimum": 1},
        "problemParseSchemaVersion": {"const": "problem-parse-v1"},
        "source": {"type": "string", "enum": ["AI", "USER"]}
      }
    },
    "subjectId": {"type": ["string", "null"], "enum": ["MATH", null]},
    "topicId": {
      "type": ["string", "null"],
      "enum": ["MATH.ARITHMETIC", "MATH.ALGEBRA", "MATH.EQUATIONS", null]
    },
    "problemType": {
      "type": "string",
      "enum": ["ARITHMETIC_EXPRESSION", "ALGEBRAIC_EXPRESSION", "EQUATION", "INEQUALITY"]
    },
    "taskType": {
      "type": "string",
      "enum": ["EVALUATE", "SIMPLIFY", "SOLVE_EQUATION", "SOLVE_INEQUALITY"]
    },
    "variables": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "verifier-input.schema.json#/$defs/variable"}
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "verifier-input.schema.json#/$defs/statement"}
    },
    "sourceConstraints": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "verifier-input.schema.json#/$defs/restriction"}
    },
    "sourceAssumptions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "provenance", "sourceBlockIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "text": {"type": "string", "maxLength": 1000},
          "provenance": {"const": "SOURCE"},
          "sourceBlockIds": {"$ref": "verifier-input.schema.json#/$defs/sourceBlockIds"}
        }
      }
    },
    "derivedRestrictions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "verifier-input.schema.json#/$defs/restriction"}
    },
    "complexityPolicy": {
      "$ref": "verifier-input.schema.json#/$defs/complexityPolicy"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedText", "displayLatex", "variables", "sourceConstraintCount", "derivedRestrictionCount", "reviewRequired"],
      "properties": {
        "normalizedText": {"type": ["string", "null"], "maxLength": 2000},
        "displayLatex": {"type": ["string", "null"], "maxLength": 2000},
        "variables": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"}
        },
        "sourceConstraintCount": {"type": "integer", "minimum": 0},
        "derivedRestrictionCount": {"type": "integer", "minimum": 0},
        "reviewRequired": {"type": "boolean"}
      }
    }
  }
}
