{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verifiedai:entitlement-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effectiveTier",
    "legacyTier",
    "status",
    "source",
    "expiresAt",
    "capabilities"
  ],
  "properties": {
    "effectiveTier": {
      "type": "string",
      "enum": [
        "FREE",
        "PRO",
        "COACH_PRO"
      ]
    },
    "legacyTier": {
      "type": "string",
      "enum": [
        "FREE",
        "PRO",
        "PRO_PLUS"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "GRACE_PERIOD",
        "BILLING_RETRY",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "DEFAULT_FREE",
        "APP_STORE_SUBSCRIPTION",
        "PROMOTIONAL",
        "ADMIN_SUPPORT"
      ]
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "BASIC_SOLVE",
          "VERIFIED_SOLVE",
          "ADVANCED_TUTOR",
          "MISTAKE_HISTORY",
          "ADAPTIVE_PLAN",
          "MOCK_EXAM",
          "PREMIUM_MODEL_FALLBACK"
        ]
      }
    },
    "packageCode": {
      "type": "string",
      "enum": [
        "FREE",
        "PRO",
        "COACH_PRO",
        "YKS_SEASON_PASS"
      ]
    },
    "gracePeriodExpiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "featureEnabled": {
      "type": "boolean"
    },
    "paidAccessActive": {
      "type": "boolean"
    },
    "learningOsCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ATTEMPT_VERIFY",
          "DETERMINISTIC_TWIN",
          "HYBRID_TWIN",
          "MISTAKE_PASSPORT_FULL",
          "DAILY_COACH_MISSION",
          "MICRO_LESSON",
          "EXAM_READINESS_SIMULATOR",
          "TIMED_MOCK_SESSION"
        ]
      }
    },
    "accessEvaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "historyAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mistakePassport": {
          "type": "string",
          "enum": [
            "FULL",
            "SUMMARY",
            "NONE"
          ]
        },
        "skillMastery": {
          "type": "string",
          "enum": [
            "FULL",
            "SUMMARY",
            "NONE"
          ]
        },
        "priorExams": {
          "type": "string",
          "enum": [
            "FULL",
            "SUMMARY",
            "NONE"
          ]
        }
      },
      "required": [
        "mistakePassport",
        "skillMastery",
        "priorExams"
      ]
    },
    "quotaSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodKey",
        "aiVerificationsUsed",
        "aiVerificationsLimit",
        "remainingAiChecks",
        "hybridTwinsUsed",
        "hybridTwinsLimit",
        "deterministicTwinsUnlimited",
        "costCircuitBreakerTripped",
        "degradedToDeterministicOnly",
        "resetsAt"
      ],
      "properties": {
        "periodKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "aiVerificationsUsed": {
          "type": "integer",
          "minimum": 0
        },
        "aiVerificationsLimit": {
          "type": "integer",
          "minimum": 0
        },
        "remainingAiChecks": {
          "type": "integer",
          "minimum": 0
        },
        "hybridTwinsUsed": {
          "type": "integer",
          "minimum": 0
        },
        "hybridTwinsLimit": {
          "type": "integer",
          "minimum": 0
        },
        "deterministicTwinsUnlimited": {
          "type": "boolean",
          "const": true
        },
        "costCircuitBreakerTripped": {
          "type": "boolean"
        },
        "degradedToDeterministicOnly": {
          "type": "boolean"
        },
        "resetsAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "EXPIRED",
              "REVOKED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "effectiveTier": {
            "const": "FREE"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "effectiveTier"
        ],
        "properties": {
          "effectiveTier": {
            "const": "FREE"
          }
        }
      },
      "then": {
        "properties": {
          "packageCode": {
            "enum": [
              "FREE"
            ]
          },
          "paidAccessActive": {
            "const": false
          },
          "learningOsCapabilities": {
            "items": {
              "enum": [
                "ATTEMPT_VERIFY",
                "DETERMINISTIC_TWIN"
              ]
            }
          },
          "capabilities": {
            "items": {
              "const": "BASIC_SOLVE"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "effectiveTier"
        ],
        "properties": {
          "effectiveTier": {
            "const": "PRO"
          }
        }
      },
      "then": {
        "properties": {
          "packageCode": {
            "enum": [
              "PRO"
            ]
          },
          "paidAccessActive": {
            "const": true
          },
          "learningOsCapabilities": {
            "items": {
              "enum": [
                "ATTEMPT_VERIFY",
                "DETERMINISTIC_TWIN",
                "HYBRID_TWIN",
                "MISTAKE_PASSPORT_FULL"
              ]
            }
          },
          "legacyTier": {
            "const": "PRO"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "effectiveTier"
        ],
        "properties": {
          "effectiveTier": {
            "const": "COACH_PRO"
          }
        }
      },
      "then": {
        "properties": {
          "packageCode": {
            "enum": [
              "COACH_PRO",
              "YKS_SEASON_PASS"
            ]
          },
          "paidAccessActive": {
            "const": true
          },
          "learningOsCapabilities": {
            "items": {
              "enum": [
                "ATTEMPT_VERIFY",
                "DETERMINISTIC_TWIN",
                "HYBRID_TWIN",
                "MISTAKE_PASSPORT_FULL",
                "DAILY_COACH_MISSION",
                "MICRO_LESSON",
                "EXAM_READINESS_SIMULATOR",
                "TIMED_MOCK_SESSION"
              ]
            }
          },
          "legacyTier": {
            "const": "PRO_PLUS"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "featureEnabled"
        ],
        "properties": {
          "featureEnabled": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "learningOsCapabilities": {
            "items": {
              "enum": [
                "ATTEMPT_VERIFY",
                "DETERMINISTIC_TWIN"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status",
          "gracePeriodExpiresAt"
        ],
        "properties": {
          "status": {
            "const": "GRACE_PERIOD"
          },
          "gracePeriodExpiresAt": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "effectiveTier": {
            "const": "FREE"
          },
          "paidAccessActive": {
            "const": false
          }
        }
      }
    }
  ]
}
