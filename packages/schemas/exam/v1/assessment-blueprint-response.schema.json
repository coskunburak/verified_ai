{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/assessment-blueprint-response.schema.json",
  "title": "AssessmentBlueprintResponse",
  "description": "Persisted assessment blueprint response with SHA-256 blueprint hash and topic rules (Sprint 9.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "examDefinitionId",
    "examVersionNumber",
    "blueprintCode",
    "title",
    "blueprintMode",
    "totalQuestionCount",
    "baseDurationSeconds",
    "easyTargetBps",
    "mediumTargetBps",
    "hardTargetBps",
    "expertTargetBps",
    "difficultyToleranceBps",
    "recallTargetBps",
    "comprehensionTargetBps",
    "applicationTargetBps",
    "analysisTargetBps",
    "evaluationTargetBps",
    "allowRecentlySeenCooldownDays",
    "shuffleQuestions",
    "shuffleOptions",
    "status",
    "blueprintHash",
    "topicRules",
    "trainingEligible",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "examDefinitionId": {
      "type": "string",
      "format": "uuid"
    },
    "examVersionNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "examSectionId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "blueprintCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "blueprintMode": {
      "type": "string",
      "enum": [
        "DIAGNOSTIC_BASELINE",
        "SECTION_DRILL",
        "FULL_SIMULATION",
        "TOPIC_MASTERY_CHECK"
      ]
    },
    "totalQuestionCount": {
      "type": "integer",
      "minimum": 5,
      "maximum": 200
    },
    "baseDurationSeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 21600
    },
    "easyTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "mediumTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "hardTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "expertTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "difficultyToleranceBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "recallTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "comprehensionTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "applicationTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "analysisTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "evaluationTargetBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "allowRecentlySeenCooldownDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "shuffleQuestions": {
      "type": "boolean"
    },
    "shuffleOptions": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "ARCHIVED"]
    },
    "blueprintHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "topicRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/BlueprintTopicRuleResponse"
      }
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "BlueprintTopicRuleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicCode",
        "targetWeightBps",
        "minQuestionCount",
        "maxQuestionCount",
        "requiredItemFormats",
        "ruleOrder",
        "trainingEligible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "topicCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "targetWeightBps": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "minQuestionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "maxQuestionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "requiredItemFormats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "SINGLE_CHOICE_MCQ",
              "MULTI_SELECT_MCQ",
              "NUMERIC_GRID_IN",
              "SHORT_STRUCTURED_RESPONSE"
            ]
          }
        },
        "ruleOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "trainingEligible": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
