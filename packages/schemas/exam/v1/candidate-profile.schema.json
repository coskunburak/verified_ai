{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/candidate-profile.schema.json",
  "title": "CandidateProfileResponse",
  "description": "Learner exam goal, study horizon, accessibility accommodations, and deterministic feasibility pacing assessment (Sprint 9.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "userId",
    "activeExamDefinitionId",
    "activeExamCode",
    "pinnedExamVersion",
    "blueprintHash",
    "activeTargetId",
    "jurisdiction",
    "targetDate",
    "targetScore",
    "dailyStudyMinutes",
    "weeklyStudyMinutes",
    "accommodations",
    "baselineMastery",
    "daysUntilExam",
    "effectiveDailyCapacityMinutes",
    "requiredDailyMinutes",
    "feasibilityStatus",
    "adjustedSections",
    "idempotentReplay",
    "llmTokensUsed",
    "trainingEligible",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "candidate-profile-v1"
    },
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "activeExamDefinitionId": {
      "type": "string",
      "format": "uuid"
    },
    "activeExamCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{3,64}$"
    },
    "pinnedExamVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,32}$"
    },
    "blueprintHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activeTargetId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["TR", "US", "UK", "INTL"]
    },
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "targetScore": {
      "type": "number",
      "minimum": -100,
      "maximum": 2000
    },
    "dailyStudyMinutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 960
    },
    "weeklyStudyMinutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 6720
    },
    "accommodations": {
      "$ref": "#/$defs/AccessibilityAccommodations"
    },
    "baselineMastery": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "daysUntilExam": {
      "type": "integer",
      "minimum": 0
    },
    "effectiveDailyCapacityMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 960
    },
    "requiredDailyMinutes": {
      "type": "integer",
      "minimum": 0
    },
    "feasibilityStatus": {
      "type": "string",
      "enum": ["OPTIMAL", "STRETCH", "AT_RISK", "UNREALISTIC"]
    },
    "adjustedSections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AdjustedExamSection"
      }
    },
    "idempotentReplay": {
      "type": "boolean"
    },
    "llmTokensUsed": {
      "type": "integer",
      "const": 0
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "AccessibilityAccommodations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraTimeMultiplier",
        "highContrastEnabled",
        "screenReaderOptimized",
        "reducedMotionEnabled"
      ],
      "properties": {
        "extraTimeMultiplier": {
          "type": "number",
          "enum": [1.0, 1.25, 1.5, 2.0]
        },
        "highContrastEnabled": {
          "type": "boolean"
        },
        "screenReaderOptimized": {
          "type": "boolean"
        },
        "reducedMotionEnabled": {
          "type": "boolean"
        }
      }
    },
    "AdjustedExamSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionCode",
        "titleEn",
        "titleTr",
        "questionCount",
        "baseDurationMinutes",
        "adjustedDurationMinutes",
        "order"
      ],
      "properties": {
        "sectionCode": {
          "type": "string",
          "minLength": 1
        },
        "titleEn": {
          "type": "string",
          "minLength": 1
        },
        "titleTr": {
          "type": "string",
          "minLength": 1
        },
        "questionCount": {
          "type": "integer",
          "minimum": 1
        },
        "baseDurationMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "adjustedDurationMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
