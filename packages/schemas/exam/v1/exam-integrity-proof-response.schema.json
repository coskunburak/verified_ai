{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/exam-integrity-proof-response.schema.json",
  "title": "ExamIntegrityProofResponse",
  "description": "Session-scoped ephemeral proof key envelope delivered over TLS with Cache-Control: no-store (Sprint 9.10 INV-EXAM-006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "userId",
    "integrityProtocolVersion",
    "keyId",
    "sessionProofKeyHex",
    "issuedAt",
    "expiresAt",
    "integrityGuardEnabled",
    "llmTokensUsed",
    "trainingEligible"
  ],
  "properties": {
    "schemaVersion": {
      "const": "exam-integrity-proof-response-v1"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "integrityProtocolVersion": {
      "const": "exam-submit-hmac-v1"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "sessionProofKeyHex": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "integrityGuardEnabled": {
      "type": "boolean"
    },
    "llmTokensUsed": {
      "const": 0
    },
    "trainingEligible": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "integrityGuardEnabled": {
            "const": true
          }
        },
        "required": [
          "integrityGuardEnabled"
        ]
      },
      "then": {
        "properties": {
          "sessionProofKeyHex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "sessionProofKeyHex": {
            "type": "null"
          }
        }
      }
    }
  ]
}
