{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/exam-score-regrade-request.schema.json",
  "title": "ExamScoreRegradeRequest",
  "description": "Explicit audited administrative/errata regrade request for a scored exam session (Sprint 9.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reasonCode",
    "reasonDetail",
    "triggeredBy"
  ],
  "properties": {
    "reasonCode": {
      "type": "string",
      "enum": [
        "ANSWER_KEY_CORRECTION",
        "PENALTY_POLICY_SYNC",
        "ADMIN_MANUAL_REGRADE"
      ]
    },
    "reasonDetail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "triggeredBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    }
  }
}
