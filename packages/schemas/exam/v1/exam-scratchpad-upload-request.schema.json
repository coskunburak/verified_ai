{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/exam-scratchpad-upload-request.schema.json",
  "title": "ExamScratchpadUploadRequest",
  "description": "Attach photographed paper deneme scratchpad or digital mock scratchpad work to an exam item for F28 post-submit verification (Sprint 9.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageNumber",
    "storageKey",
    "mimeType",
    "byteSize",
    "sha256Checksum",
    "captureSource",
    "trainingEligible"
  ],
  "properties": {
    "pageNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "storageKey": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512
    },
    "mimeType": {
      "type": "string",
      "enum": ["image/jpeg", "image/png", "image/heic"]
    },
    "byteSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15728640
    },
    "sha256Checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "widthPx": {
      "type": ["integer", "null"],
      "minimum": 200,
      "maximum": 12000
    },
    "heightPx": {
      "type": ["integer", "null"],
      "minimum": 200,
      "maximum": 12000
    },
    "captureSource": {
      "type": "string",
      "enum": ["DIGITAL_MOCK_SCRATCHPAD", "PAPER_DENEME_BOOKLET"]
    },
    "bookletPublisher": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "capturedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    }
  }
}
