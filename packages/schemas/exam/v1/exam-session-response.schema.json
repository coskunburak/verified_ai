{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/exam-session-response.schema.json",
  "title": "ExamSessionResponse",
  "description": "Server-authoritative timed mock exam session state with clock sync, no-hint policy, answer-key-free item snapshots, and F28 scratchpad batch manifest (Sprint 9.4 / CNT-LOS-10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "userId",
    "assemblyId",
    "blueprintId",
    "examCode",
    "examVersionNumber",
    "status",
    "navigationPolicy",
    "noHintPolicyEnforced",
    "accommodationsSnapshot",
    "baseDurationSeconds",
    "extraTimeMultiplier",
    "effectiveDurationSeconds",
    "offlineGraceBufferSeconds",
    "startedAt",
    "serverDeadlineAt",
    "graceDeadlineAt",
    "lastHeartbeatAt",
    "totalItemCount",
    "answeredItemCount",
    "flaggedItemCount",
    "omittedItemCount",
    "scratchpadAttachmentCount",
    "clockSync",
    "sectionProgress",
    "items",
    "llmTokensUsed",
    "trainingEligible"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "exam-session-response-v1"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "assemblyId": {
      "type": "string",
      "format": "uuid"
    },
    "blueprintId": {
      "type": "string",
      "format": "uuid"
    },
    "examCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "examVersionNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "OFFLINE_GRACE_BUFFER",
        "SUBMITTED",
        "EXPIRED_AUTO_SUBMITTED",
        "ABANDONED"
      ]
    },
    "navigationPolicy": {
      "type": "string",
      "enum": [
        "FREE_NAVIGATION",
        "SECTION_LOCKED"
      ]
    },
    "noHintPolicyEnforced": {
      "type": "boolean",
      "const": true
    },
    "accommodationsSnapshot": {
      "$ref": "#/$defs/AppliedAccommodationSnapshot"
    },
    "baseDurationSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 21600
    },
    "extraTimeMultiplier": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 2.0
    },
    "effectiveDurationSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 32400
    },
    "offlineGraceBufferSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "serverDeadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "graceDeadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastHeartbeatAt": {
      "type": "string",
      "format": "date-time"
    },
    "submittedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "submissionReason": {
      "type": ["string", "null"],
      "enum": [
        "USER_INITIATED",
        "SERVER_DEADLINE_EXPIRED",
        "OFFLINE_GRACE_EXHAUSTED",
        "USER_ABANDONED",
        null
      ]
    },
    "totalItemCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "answeredItemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "flaggedItemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "omittedItemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "scratchpadAttachmentCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 800
    },
    "clockSync": {
      "$ref": "#/$defs/ExamServerClockSync"
    },
    "sectionProgress": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ExamSectionProgressSummary"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ExamSessionItemSnapshot"
      }
    },
    "f28VerificationBatchManifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/F28VerificationBatchManifest"
        },
        {
          "type": "null"
        }
      ]
    },
    "llmTokensUsed": {
      "type": "integer",
      "const": 0
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "AppliedAccommodationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeMultiplier",
        "highContrastMode",
        "screenReaderOptimized",
        "extendedBreakPrompts"
      ],
      "properties": {
        "timeMultiplier": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 2.0
        },
        "highContrastMode": {
          "type": "boolean"
        },
        "screenReaderOptimized": {
          "type": "boolean"
        },
        "extendedBreakPrompts": {
          "type": "boolean"
        }
      }
    },
    "ExamServerClockSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverNow",
        "remainingSeconds",
        "graceRemainingSeconds",
        "clientClockSkewMs",
        "clockSkewAnomaly",
        "deadlineExpired",
        "offlineGraceActive"
      ],
      "properties": {
        "serverNow": {
          "type": "string",
          "format": "date-time"
        },
        "remainingSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "graceRemainingSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "clientClockSkewMs": {
          "type": "integer"
        },
        "clockSkewAnomaly": {
          "type": "boolean"
        },
        "deadlineExpired": {
          "type": "boolean"
        },
        "offlineGraceActive": {
          "type": "boolean"
        }
      }
    },
    "ExamSectionProgressSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionCode",
        "sectionOrder",
        "totalItems",
        "answeredItems",
        "flaggedItems",
        "omittedItems",
        "locked"
      ],
      "properties": {
        "sectionCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "sectionOrder": {
          "type": "integer",
          "minimum": 1
        },
        "totalItems": {
          "type": "integer",
          "minimum": 1
        },
        "answeredItems": {
          "type": "integer",
          "minimum": 0
        },
        "flaggedItems": {
          "type": "integer",
          "minimum": 0
        },
        "omittedItems": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "SessionItemOptionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionKey",
        "displayOrder",
        "contentMarkdown",
        "trainingEligible"
      ],
      "properties": {
        "optionKey": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "E"]
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "contentMarkdown": {
          "type": "string",
          "minLength": 1
        },
        "contentLatex": {
          "type": ["string", "null"]
        },
        "trainingEligible": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "ExamScratchpadAssetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sessionId",
        "sessionItemId",
        "itemPosition",
        "pageNumber",
        "storageKey",
        "mimeType",
        "byteSize",
        "sha256Checksum",
        "captureSource",
        "f28VerificationStatus",
        "capturedAt",
        "trainingEligible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "sessionItemId": {
          "type": "string",
          "format": "uuid"
        },
        "itemPosition": {
          "type": "integer",
          "minimum": 1
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "storageKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 512
        },
        "mimeType": {
          "type": "string",
          "enum": ["image/jpeg", "image/png", "image/heic"]
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15728640
        },
        "sha256Checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "widthPx": {
          "type": ["integer", "null"],
          "minimum": 200,
          "maximum": 12000
        },
        "heightPx": {
          "type": ["integer", "null"],
          "minimum": 200,
          "maximum": 12000
        },
        "captureSource": {
          "type": "string",
          "enum": ["DIGITAL_MOCK_SCRATCHPAD", "PAPER_DENEME_BOOKLET"]
        },
        "bookletPublisher": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "f28VerificationStatus": {
          "type": "string",
          "enum": ["QUEUED_FOR_POST_SUBMIT_BATCH", "NOT_APPLICABLE"]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "trainingEligible": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "ExamSessionItemSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "itemPosition",
        "questionItemId",
        "questionCode",
        "sectionCode",
        "sectionOrder",
        "topicCode",
        "itemFormat",
        "difficultyBand",
        "stemMarkdown",
        "optionsSnapshot",
        "maxPoints",
        "negativeMarkingWeight",
        "responseState",
        "flaggedForReview",
        "eliminatedOptionKeys",
        "timeSpentSeconds",
        "autosaveVersion",
        "clientAutosaveSeq",
        "scratchpadRequired",
        "scratchpadAssets",
        "trainingEligible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "itemPosition": {
          "type": "integer",
          "minimum": 1
        },
        "questionItemId": {
          "type": "string",
          "format": "uuid"
        },
        "questionCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "sectionCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "sectionOrder": {
          "type": "integer",
          "minimum": 1
        },
        "topicCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "itemFormat": {
          "type": "string",
          "enum": [
            "SINGLE_CHOICE_MCQ",
            "MULTI_SELECT_MCQ",
            "NUMERIC_GRID_IN",
            "SHORT_STRUCTURED_RESPONSE",
            "SINGLE_CHOICE_4_OPTION",
            "SINGLE_CHOICE_5_OPTION"
          ]
        },
        "difficultyBand": {
          "type": "string",
          "enum": ["EASY", "MEDIUM", "HARD", "EXPERT"]
        },
        "stemMarkdown": {
          "type": "string",
          "minLength": 5
        },
        "optionsSnapshot": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionItemOptionSnapshot"
          }
        },
        "figureAltText": {
          "type": ["string", "null"]
        },
        "maxPoints": {
          "type": "number",
          "minimum": 0.1
        },
        "negativeMarkingWeight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "responseState": {
          "type": "string",
          "enum": [
            "UNVISITED",
            "VIEWED_OMITTED",
            "ANSWERED",
            "FLAGGED_ANSWERED",
            "FLAGGED_OMITTED"
          ]
        },
        "selectedOptionKey": {
          "type": ["string", "null"],
          "enum": ["A", "B", "C", "D", "E", null]
        },
        "numericResponseValue": {
          "type": ["number", "null"]
        },
        "flaggedForReview": {
          "type": "boolean"
        },
        "eliminatedOptionKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E"]
          }
        },
        "timeSpentSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32400
        },
        "autosaveVersion": {
          "type": "integer",
          "minimum": 0
        },
        "clientAutosaveSeq": {
          "type": "integer",
          "minimum": 0
        },
        "lastAutosavedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "scratchpadRequired": {
          "type": "boolean"
        },
        "scratchpadAssets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExamScratchpadAssetSnapshot"
          }
        },
        "trainingEligible": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "F28VerificationBatchEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "sessionItemId",
        "itemPosition",
        "pageNumber",
        "questionCode",
        "topicCode",
        "storageKey",
        "sha256Checksum",
        "captureSource",
        "f28VerificationStatus"
      ],
      "properties": {
        "assetId": { "type": "string", "format": "uuid" },
        "sessionItemId": { "type": "string", "format": "uuid" },
        "itemPosition": { "type": "integer", "minimum": 1 },
        "pageNumber": { "type": "integer", "minimum": 1, "maximum": 4 },
        "questionCode": { "type": "string", "minLength": 3 },
        "topicCode": { "type": "string", "minLength": 3 },
        "storageKey": { "type": "string", "minLength": 10 },
        "sha256Checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "captureSource": { "type": "string", "enum": ["DIGITAL_MOCK_SCRATCHPAD", "PAPER_DENEME_BOOKLET"] },
        "bookletPublisher": { "type": ["string", "null"], "maxLength": 120 },
        "f28VerificationStatus": { "type": "string", "enum": ["QUEUED_FOR_POST_SUBMIT_BATCH", "NOT_APPLICABLE"] }
      }
    },
    "F28VerificationBatchManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchVersion",
        "batchStatus",
        "sessionId",
        "userId",
        "examCode",
        "totalAssets",
        "llmTokensUsed",
        "trainingEligible",
        "generatedAt",
        "assets"
      ],
      "properties": {
        "batchVersion": { "type": "string", "const": "f28-batch-manifest-v1" },
        "batchStatus": { "type": "string", "enum": ["QUEUED_FOR_F28_BATCH", "EMPTY_NO_SCRATCHPADS"] },
        "sessionId": { "type": "string", "format": "uuid" },
        "userId": { "type": "string", "format": "uuid" },
        "examCode": { "type": "string", "minLength": 3 },
        "totalAssets": { "type": "integer", "minimum": 0 },
        "llmTokensUsed": { "type": "integer", "const": 0 },
        "trainingEligible": { "type": "boolean", "const": false },
        "generatedAt": { "type": "string", "format": "date-time" },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/F28VerificationBatchEntry"
          }
        }
      }
    }
  }
}
