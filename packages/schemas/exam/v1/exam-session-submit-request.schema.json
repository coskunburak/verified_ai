{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/exam-session-submit-request.schema.json",
  "title": "ExamSessionSubmitRequest",
  "description": "Idempotent exam session submission request (Sprint 9.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionReason",
    "trainingEligible"
  ],
  "properties": {
    "submissionReason": {
      "type": "string",
      "enum": [
        "USER_INITIATED",
        "SERVER_DEADLINE_EXPIRED",
        "OFFLINE_GRACE_EXHAUSTED",
        "USER_ABANDONED"
      ]
    },
    "clientTimestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "submissionSignature": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "integrityKeyId": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "submissionNonce": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "integrityProtocolVersion": {
      "type": ["string", "null"],
      "enum": ["exam-submit-hmac-v1", null]
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    }
  }
}
