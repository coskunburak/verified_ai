{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/exam/v1/syllabus-ingestion.schema.json",
  "title": "SyllabusIngestionResponse",
  "description": "Snap-to-Plan multimodal syllabus extraction and deterministic curriculum disambiguation result (Sprint 9.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "uploadId",
    "userId",
    "examDefinitionId",
    "examCode",
    "examVersion",
    "imageHash",
    "mimeType",
    "byteSize",
    "status",
    "deduplicatedFromCache",
    "idempotentReplay",
    "remainingMonthlyQuota",
    "parsedTopics",
    "llmTokensUsed",
    "trainingEligible",
    "expiresAt",
    "confirmedAt",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "syllabus-ingestion-v1"
    },
    "uploadId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "examDefinitionId": {
      "type": "string",
      "format": "uuid"
    },
    "examCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{3,64}$"
    },
    "examVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,32}$"
    },
    "imageHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mimeType": {
      "type": "string",
      "enum": ["image/jpeg", "image/png", "image/webp", "image/heic", "application/pdf"]
    },
    "byteSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "status": {
      "type": "string",
      "enum": ["PARSED_AUTO_CONFIRMED", "NEEDS_DISAMBIGUATION", "USER_CONFIRMED", "REJECTED"]
    },
    "deduplicatedFromCache": {
      "type": "boolean"
    },
    "idempotentReplay": {
      "type": "boolean"
    },
    "remainingMonthlyQuota": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "parsedTopics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ParsedSyllabusTopicItem"
      }
    },
    "llmTokensUsed": {
      "type": "integer",
      "minimum": 0
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "confirmedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "DisambiguationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "topicId",
        "similarityScore"
      ],
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1
        },
        "topicId": {
          "type": "string",
          "minLength": 1
        },
        "similarityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ParsedSyllabusTopicItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemIndex",
        "rawTopicLabel",
        "targetWeek",
        "targetMonth",
        "extractionConfidence",
        "matchedSkillId",
        "matchedTopicId",
        "similarityScore",
        "autoConfirmed",
        "userConfirmed",
        "candidates"
      ],
      "properties": {
        "itemIndex": {
          "type": "integer",
          "minimum": 0
        },
        "rawTopicLabel": {
          "type": "string",
          "minLength": 1
        },
        "targetWeek": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 53
        },
        "targetMonth": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "extractionConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matchedSkillId": {
          "type": ["string", "null"]
        },
        "matchedTopicId": {
          "type": ["string", "null"]
        },
        "similarityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "autoConfirmed": {
          "type": "boolean"
        },
        "userConfirmed": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DisambiguationCandidate"
          }
        }
      }
    }
  }
}
