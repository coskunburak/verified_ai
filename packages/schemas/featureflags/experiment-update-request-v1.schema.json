{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedai.com/schemas/featureflags/experiment-update-request-v1.schema.json",
  "title": "ExperimentUpdateRequest",
  "description": "ROLE_ADMIN request to transition an A/B experiment state or update traffic rollout basis points.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "rolloutBasisPoints",
    "reason",
    "expectedVersion",
    "trainingEligible"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "RUNNING",
        "PAUSED",
        "KILLED",
        "CONCLUDED"
      ]
    },
    "rolloutBasisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "reason": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    }
  }
}
