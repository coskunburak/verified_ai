{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-visualization-context-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "math-visualization-context-v1"
    },
    "enabled": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalId": {
          "type": "string",
          "format": "uuid"
        },
        "canonicalRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "parseId": {
          "type": "string",
          "format": "uuid"
        },
        "parseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "canonicalId",
        "canonicalRevision",
        "parseId",
        "parseRevision"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "enabled",
    "source"
  ]
}
