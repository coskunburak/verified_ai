          "methods": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNAVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "reasonCode": {
            "enum": [
              "TIMEOUT",
              "RESOURCE_FAILURE",
              "WORKER_FAILURE",
              "ADMISSION_LIMIT",
              "INVALID_RESPONSE",
              "DISABLED"
            ]
          },
          "methods": {
            "maxItems": 0
          }
        }
      }
    }
