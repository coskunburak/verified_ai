          "source": {
            "properties": {
              "domainBasis": {
                "enum": [
                  "SOURCE_EXPLICIT",
                  "REVIEWED_REAL_TASK"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNSUPPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "reasonCode": {
            "enum": [
              "UNSUPPORTED_SOURCE"
            ]
