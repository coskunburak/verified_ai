{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "method-comparison-result-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "method-comparison-result-v2"
    },
    "verifierVersion": {
      "const": "bounded-methods-v2"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "maxLength": 64
    },
    "action": {
      "const": "METHODS"
    },
    "status": {
      "enum": [
        "VERIFIED",
        "UNSUPPORTED",
        "UNAVAILABLE",
        "NO_ALTERNATIVE"
      ]
    },
    "reasonCode": {
      "enum": [
        "EXACT_METHODS",
        "UNSUPPORTED_SOURCE",
        "NO_DISTINCT_DERIVATION",
        "TIMEOUT",
        "RESOURCE_FAILURE",
        "WORKER_FAILURE",
        "ADMISSION_LIMIT",
        "INVALID_RESPONSE",
        "DISABLED"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "original": {
          "$ref": "#/$defs/Statement"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
              },
              "domain": {
                "enum": [
                  "REAL",
                  "INTEGER",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "symbol",
              "domain"
            ]
          },
          "minItems": 0,
          "maxItems": 1
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "relation": {
                "enum": [
                  "EQUALS",
                  "NOT_EQUALS",
                  "LESS_THAN",
                  "LESS_THAN_OR_EQUAL",
                  "GREATER_THAN",
                  "GREATER_THAN_OR_EQUAL"
                ]
              },
              "left": {
                "$ref": "#/$defs/Node"
              },
              "right": {
                "$ref": "#/$defs/Node"
              }
            },
            "required": [
              "id",
              "relation",
              "left",
              "right"
            ]
          },
          "minItems": 0,
          "maxItems": 48
        },
        "domainBasis": {
          "enum": [
            "SOURCE_EXPLICIT",
            "REVIEWED_REAL_TASK",
            "UNRESOLVED"
          ]
        }
      },
      "required": [
        "original",
        "variables",
        "restrictions",
        "domainBasis"
      ]
    },
    "naturalDomain": {
      "anyOf": [
        {
          "$ref": "#/$defs/Node"
        },
        {
          "type": "null"
        }
      ]
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "methodId": {
            "enum": [
              "FACTORING",
              "COMPLETING_SQUARE",
              "QUADRATIC_FORMULA",
              "SYMBOLIC_SIMPLIFICATION",
              "POLYNOMIAL_EXPANSION",
              "DIRECT_ALGEBRA",
              "RATIONAL_CLEARING",
              "ABSOLUTE_CASES"
            ]
          },
          "evidenceVersion": {
            "const": "verified-method-v2"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Statement"
            },
            "minItems": 1,
            "maxItems": 4
          },
          "stepReasons": {
            "type": "array",
            "items": {
              "enum": [
                "NORMALIZE_ZERO",
                "COMPLETE_REAL_SET",
                "ZERO_PRODUCT",
                "SQUARE_IDENTITY",
                "DISCRIMINANT_FORMULA",
                "EXACT_SIMPLIFICATION",
                "EXPAND_COLLECT",
                "ISOLATE_VARIABLE",
                "CLEAR_DENOMINATORS",
                "SPLIT_ABSOLUTE_CASES"
              ]
            },
            "minItems": 1,
            "maxItems": 4
          },
          "proofScope": {
            "const": "SOURCE_DOMAIN_COMPLETE_OUTCOME"
          },
          "transitionStatus": {
            "const": "EXACT_SYMBOLIC"
          },
          "outcomeStatus": {
            "enum": [
              "COMPLETE_SOLUTION_SET",
              "EXPRESSION_IDENTITY"
            ]
          },
          "comparison": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "policyVersion": {
                "const": "method-comparison-policy-v3"
              },
              "presentationVersion": {
                "const": "method-presentation-v2"
              },
              "applicability": {
                "enum": [
                  "RATIONAL_QUADRATIC",
                  "RATIONAL_POLYNOMIAL",
                  "RATIONAL_LINEAR",
                  "CONSTANT_EQUATION",
                  "RATIONAL_EQUATION",
                  "ABSOLUTE_AFFINE"
                ]
              },
              "reasonCode": {
                "enum": [
                  "ZERO_PRODUCT",
                  "SQUARE_IDENTITY",
                  "DISCRIMINANT_FORMULA",
                  "EXACT_SIMPLIFICATION",
                  "EXPAND_COLLECT",
                  "ISOLATE_VARIABLE",
                  "CLEAR_DENOMINATORS",
                  "SPLIT_ABSOLUTE_CASES"
                ]
              },
              "prerequisite": {
                "enum": [
                  "FACTORING",
                  "SQUARE_IDENTITIES",
                  "QUADRATIC_FORMULA",
                  "POLYNOMIAL_ALGEBRA",
                  "LINEAR_ALGEBRA",
                  "DOMAIN_AND_FACTORS",
                  "PIECEWISE_SIGNS"
                ]
              },
              "advantage": {
                "enum": [
                  "VISIBLE_FACTORS",
                  "VISIBLE_VERTEX",
                  "GENERAL_QUADRATIC",
                  "NORMALIZED_EXPRESSION",
                  "VISIBLE_COEFFICIENTS",
                  "DIRECT_OUTCOME",
                  "VISIBLE_NUMERATOR",
                  "EXPLICIT_BRANCHES"
                ]
              },
              "limitation": {
                "enum": [
                  "FACTOR_DISCOVERY",
                  "FRACTION_ARITHMETIC",
                  "FORMULA_SUBSTITUTION",
                  "BOUNDED_POLYNOMIAL",
                  "EXPANSION_GROWTH",
                  "LINEAR_ONLY",
                  "EXCLUDED_ROOTS",
                  "AFFINE_ABSOLUTE_ONLY"
                ]
              },
              "domainCautions": {
                "type": "array",
                "items": {
                  "enum": [
                    "REAL_DOMAIN",
                    "SOURCE_RESTRICTIONS",
                    "NATURAL_DOMAIN_EXCLUSIONS"
                  ]
                },
                "minItems": 1,
                "maxItems": 3
              },
              "structuralStepCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "compactStepIndices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true
              },
              "manipulationLevel": {
                "enum": [
                  "LOW",
                  "MODERATE"
                ]
              },
              "recommendation": {
                "enum": [
                  "REPEATED_ROOT_STRUCTURE",
                  "FACTORABLE_OVER_RATIONALS",
                  "NEGATIVE_DISCRIMINANT",
                  "DIRECT_SQUARE",
                  "VERTEX_FORM",
                  "EXACT_RADICAL_FORMULA",
                  "EQUALLY_VALID",
                  "EXPOSE_FACTORS",
                  "COLLECT_TERMS",
                  "ISOLATE_LINEAR",
                  "RESOLVE_CONSTANT",
                  "PRESERVE_DOMAIN_HOLES",
                  "SPLIT_ABSOLUTE_CASES"
                ]
              }
            },
            "required": [
              "policyVersion",
              "presentationVersion",
              "applicability",
              "reasonCode",
              "prerequisite",
              "advantage",
              "limitation",
              "domainCautions",
              "structuralStepCount",
              "compactStepIndices",
              "manipulationLevel",
              "recommendation"
