{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mistake-passport-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "mistake-passport-v1"
    },
    "trainingEligible": {
      "const": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "drill_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_source": {
            "enum": [
              "ATTEMPT_DISPROOF",
              "TWIN_COMPLETION"
            ]
          },
          "skill_id": {
            "type": "string",
            "maxLength": 128
          },
          "mistake_code": {
            "type": "string",
            "maxLength": 128
          },
          "correct": {
            "type": "boolean"
          },
          "assistance": {
            "enum": [
              "UNKNOWN",
              "INDEPENDENT",
              "HINT_ASSISTED"
            ]
          },
          "verifier_version": {
            "type": "string",
            "maxLength": 128
          },
          "assessed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "attempt_id",
          "drill_id",
          "evidence_source",
          "skill_id",
          "mistake_code",
          "correct",
          "assistance",
          "verifier_version",
          "assessed_at"
        ]
      },
      "maxItems": 60
    },
    "mastery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skill_id": {
            "type": "string",
            "maxLength": 128
          },
          "mastery_version": {
            "const": "bkt-lite-v1"
          },
          "score": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 0.99
          },
          "half_life_days": {
            "type": "number",
            "minimum": 1,
            "maximum": 90
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "last_assessed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "skill_id",
          "mastery_version",
          "score",
          "half_life_days",
          "evidence_count",
          "confidence",
          "last_assessed_at"
        ]
      },
      "maxItems": 17
    }
  },
  "required": [
    "schemaVersion",
    "trainingEligible",
    "events",
    "mastery"
  ]
}
