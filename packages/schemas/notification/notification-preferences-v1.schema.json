{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verifiedai:notification-preferences-v1",
  "title": "NotificationPreferencesResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "userId",
    "pushEnabled",
    "studyPlanEnabled",
    "spacedReviewEnabled",
    "examDeadlineEnabled",
    "billingTrialReminderEnabled",
    "accountSecurityEnabled",
    "quietHoursEnabled",
    "quietHoursStartLocal",
    "quietHoursEndLocal",
    "timezone",
    "dailyCap",
    "version",
    "trainingEligible",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "notification-preferences-v1"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "pushEnabled": {
      "type": "boolean"
    },
    "studyPlanEnabled": {
      "type": "boolean"
    },
    "spacedReviewEnabled": {
      "type": "boolean"
    },
    "examDeadlineEnabled": {
      "type": "boolean"
    },
    "billingTrialReminderEnabled": {
      "type": "boolean"
    },
    "accountSecurityEnabled": {
      "type": "boolean",
      "const": true
    },
    "quietHoursEnabled": {
      "type": "boolean"
    },
    "quietHoursStartLocal": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "quietHoursEndLocal": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "dailyCap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "trainingEligible": {
      "type": "boolean",
      "const": false
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
