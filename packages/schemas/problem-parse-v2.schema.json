{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verified-ai:problem-parse:v2",
  "title": "Typed calculus ProblemParse v2",
  "description": "Explicit bounded calculus metadata admitted through authenticated USER correction with existing recognition lineage. Source declarations do not verify a proposed solution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "supportStatus",
    "subjectId",
    "topicId",
    "taskType",
    "problemType",
    "expressions",
    "variables",
    "constraints",
    "assumptions",
    "uncertainty",
    "sourceEvidenceRefs",
    "visualQualityRisks",
    "reviewRequired",
    "calculus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "problem-parse-v2"
    },
    "supportStatus": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "REVIEW_REQUIRED",
        "UNSUPPORTED"
      ]
    },
    "unsupportedReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "UNSUPPORTED_SUBJECT",
        "UNSUPPORTED_TOPIC",
        "UNSUPPORTED_TASK",
        "UNSUPPORTED_STRUCTURE",
        "MULTI_PART_UNSUPPORTED",
        "DIAGRAM_REQUIRED",
        "TEXT_HEAVY_WORD_PROBLEM",
        "INSUFFICIENT_RECOGNITION_EVIDENCE",
        "SCHEMA_CANNOT_REPRESENT",
        null
      ]
    },
    "subjectId": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "MATH",
        null
      ]
    },
    "topicId": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "MATH.ARITHMETIC",
        "MATH.ALGEBRA",
        "MATH.EQUATIONS",
        "MATH.FUNCTIONS",
        "MATH.CALCULUS.LIMITS",
        "MATH.CALCULUS.DIFFERENTIATION",
        "MATH.CALCULUS.INTEGRATION",
        null
      ]
    },
    "taskType": {
      "enum": [
        "DIFFERENTIATE",
        "INTEGRATE",
        "FIND_LIMIT"
      ]
    },
    "problemType": {
      "enum": [
        "DERIVATIVE",
        "INTEGRAL",
        "LIMIT"
      ]
    },
    "expressions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/expression"
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "sourceEvidenceRefs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/sourceEvidenceRef"
      }
    },
    "visualQualityRisks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/visualQualityRisk"
      }
    },
    "reviewRequired": {
      "type": "boolean"
    },
    "calculus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
            },
            "domain": {
              "const": "REAL"
            }
          },
          "required": [
            "symbol",
            "domain"
          ]
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "OPEN_INTERVAL"
            },
            "lower": {
              "anyOf": [
                {
                  "$ref": "#/$defs/exact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "upper": {
              "anyOf": [
                {
                  "$ref": "#/$defs/exact"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "lower",
            "upper"
          ]
        },
        "original": {
          "$ref": "#/$defs/expressionNode"
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "EQUALS",
                  "NOT_EQUALS",
                  "LESS_THAN",
                  "LESS_THAN_OR_EQUAL",
                  "GREATER_THAN",
                  "GREATER_THAN_OR_EQUAL"
                ]
              },
              "left": {
                "$ref": "#/$defs/expressionNode"
              },
              "right": {
                "$ref": "#/$defs/expressionNode"
              }
            },
            "required": [
              "id",
              "relation",
              "left",
              "right"
            ]
          },
          "maxItems": 48
        },
        "approach": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "#/$defs/exact"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "LEFT",
                    "RIGHT",
                    "TWO_SIDED"
                  ]
                }
              },
              "required": [
                "target",
                "direction"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "integralScope": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ANTIDERIVATIVE_REPRESENTATIVE"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "variable",
        "interval",
        "original",
        "restrictions",
        "approach",
        "integralScope"
      ]
    }
  },
  "$defs": {
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "sourceText",
        "normalizedText",
        "displayLatex",
        "sourceBlockIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "GIVEN",
            "TARGET",
            "CONSTRAINT"
          ]
        },
        "sourceText": {
          "type": "string",
          "maxLength": 2000
        },
        "normalizedText": {
          "type": "string",
          "maxLength": 2000
        },
        "displayLatex": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "relation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "EQUALS",
            "LESS_THAN",
            "LESS_THAN_OR_EQUAL",
            "GREATER_THAN",
            "GREATER_THAN_OR_EQUAL",
            null
          ]
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/sourceBlockIds"
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "role",
        "sourceBlockIds"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "VARIABLE",
            "PARAMETER",
            "UNKNOWN"
          ]
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/sourceBlockIds"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceText",
        "normalizedText",
        "variables",
        "explicit",
        "sourceBlockIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceText": {
          "type": "string",
          "maxLength": 2000
        },
        "normalizedText": {
          "type": "string",
          "maxLength": 2000
        },
        "variables": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
          }
        },
        "explicit": {
          "const": true
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/sourceBlockIds"
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "explicit",
        "sourceBlockIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "explicit": {
          "const": true
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/sourceBlockIds"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recognition",
        "parse",
        "reviewRequired"
      ],
      "properties": {
        "recognition": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "parse": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "reviewRequired": {
          "type": "boolean"
        }
      }
    },
    "sourceEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "fieldPath"
      ],
      "properties": {
        "blockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fieldPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "visualQualityRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalType",
        "severity"
      ],
      "properties": {
        "signalType": {
          "type": "string",
          "maxLength": 64
        },
        "severity": {
          "type": "string",
          "enum": [
            "PASS",
            "WARNING",
            "BLOCKING"
          ]
        },
        "messageCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96
        }
      }
    },
    "sourceBlockIds": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "expressionNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/numberNode"
        },
        {
          "$ref": "#/$defs/variableNode"
        },
        {
          "$ref": "#/$defs/unaryNode"
        },
        {
          "$ref": "#/$defs/binaryNode"
        },
        {
          "$ref": "#/$defs/functionNode"
        }
      ]
    },
    "numberNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "numericType",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "NUMBER"
        },
        "numericType": {
          "type": "string",
          "enum": [
            "INTEGER",
            "DECIMAL",
            "RATIONAL"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 80
        }
      }
    },
    "variableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol"
      ],
      "properties": {
        "kind": {
          "const": "VARIABLE"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
        }
      }
    },
    "unaryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator",
        "operand"
      ],
      "properties": {
        "kind": {
          "const": "UNARY"
        },
        "operator": {
          "type": "string",
          "enum": [
            "NEGATE"
          ]
        },
        "operand": {
          "$ref": "#/$defs/expressionNode"
        }
      }
    },
    "binaryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "BINARY"
        },
        "operator": {
          "type": "string",
          "enum": [
            "ADD",
            "SUBTRACT",
            "MULTIPLY",
            "DIVIDE",
            "POWER"
          ]
        },
        "left": {
          "$ref": "#/$defs/expressionNode"
        },
        "right": {
          "$ref": "#/$defs/expressionNode"
        }
      }
    },
    "functionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "function",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "FUNCTION"
        },
        "function": {
          "type": "string",
          "enum": [
            "SQRT",
            "SIN",
            "COS",
            "TAN",
            "LOG",
            "EXP"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/expressionNode"
          }
        }
      }
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "EXPRESSION"
            },
            "expression": {
              "$ref": "#/$defs/expressionNode"
            },
            "left": {
              "type": "null"
            },
            "right": {
              "type": "null"
            },
            "relation": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "expression"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "RELATION"
            },
            "relation": {
              "const": "EQUALS"
            },
            "left": {
              "$ref": "#/$defs/expressionNode"
            },
            "right": {
              "$ref": "#/$defs/expressionNode"
            },
            "expression": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "relation",
            "left",
            "right"
          ]
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "format": "uuid"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "candidateRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sourceVersion": {
          "const": "calculus-task-v1"
        },
        "candidateVersion": {
          "const": "calculus-task-v1"
        }
      },
      "required": [
        "identity",
        "sourceRevision",
        "candidateRevision",
        "sourceVersion",
        "candidateVersion"
      ]
    },
    "exact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "maxLength": 320
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 320
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    }
  }
}
