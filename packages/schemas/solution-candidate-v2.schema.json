{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verified-ai:solution-candidate:v2",
  "title": "Calculus solution candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalProblemId",
    "problemParseId",
    "problemParseRevision",
    "candidateVersion",
    "generationOrigin",
    "problemType",
    "taskType",
    "method",
    "steps",
    "finalAnswer",
    "sourceAssumptionIds",
    "sourceConstraintIds",
    "derivedRestrictionIds",
    "ambiguities",
    "unresolvedIssues",
    "canonicalRevision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "solution-candidate-v2"
    },
    "canonicalProblemId": {
      "type": "string",
      "format": "uuid"
    },
    "problemParseId": {
      "type": "string",
      "format": "uuid"
    },
    "problemParseRevision": {
      "type": "integer",
      "minimum": 1
    },
    "candidateVersion": {
      "const": 2
    },
    "generationOrigin": {
      "type": "string",
      "enum": [
        "AI_MODEL",
        "LOCAL_FIXTURE"
      ]
    },
    "problemType": {
      "enum": [
        "DERIVATIVE",
        "INTEGRAL",
        "LIMIT"
      ]
    },
    "taskType": {
      "enum": [
        "DIFFERENTIATE",
        "INTEGRATE",
        "FIND_LIMIT"
      ]
    },
    "method": {
      "enum": [
        "DERIVATIVE_BACKCHECK",
        "INTEGRAL_DIFFERENTIATION_BACKCHECK",
        "FINITE_LIMIT"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "category",
          "claim",
          "explanation",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "category": {
            "type": "string",
            "enum": [
              "RESTATE",
              "TRANSFORM",
              "CONCLUDE"
            ]
          },
          "claim": {
            "$ref": "#/$defs/statement"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "dependsOn": {
            "type": "array",
            "minItems": 0,
            "maxItems": 24,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "uniqueItems": true
          }
        }
      }
    },
    "finalAnswer": {
      "$ref": "#/$defs/statement"
    },
    "sourceAssumptionIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "uniqueItems": true
    },
    "sourceConstraintIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "uniqueItems": true
    },
    "derivedRestrictionIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "uniqueItems": true
    },
    "ambiguities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "unresolvedIssues": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "canonicalRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "$defs": {
    "expressionNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/numberNode"
        },
        {
          "$ref": "#/$defs/variableNode"
        },
        {
          "$ref": "#/$defs/unaryNode"
        },
        {
          "$ref": "#/$defs/binaryNode"
        },
        {
          "$ref": "#/$defs/functionNode"
        }
      ]
    },
    "numberNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "numericType",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "NUMBER"
        },
        "numericType": {
          "type": "string",
          "enum": [
            "INTEGER",
            "DECIMAL",
            "RATIONAL"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 80
        }
      }
    },
    "variableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol"
      ],
      "properties": {
        "kind": {
          "const": "VARIABLE"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
        }
      }
    },
    "unaryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator",
        "operand"
      ],
      "properties": {
        "kind": {
          "const": "UNARY"
        },
        "operator": {
          "type": "string",
          "enum": [
            "NEGATE"
          ]
        },
        "operand": {
          "$ref": "#/$defs/expressionNode"
        }
      }
    },
    "binaryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "BINARY"
        },
        "operator": {
          "type": "string",
          "enum": [
            "ADD",
            "SUBTRACT",
            "MULTIPLY",
            "DIVIDE",
            "POWER"
          ]
        },
        "left": {
          "$ref": "#/$defs/expressionNode"
        },
        "right": {
          "$ref": "#/$defs/expressionNode"
        }
      }
    },
    "functionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "function",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "FUNCTION"
        },
        "function": {
          "type": "string",
          "enum": [
            "SQRT",
            "SIN",
            "COS",
            "TAN",
            "LOG",
            "EXP"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/expressionNode"
          }
        }
      }
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expression"
          ],
          "properties": {
            "kind": {
              "const": "EXPRESSION"
            },
            "expression": {
              "$ref": "#/$defs/expressionNode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "relation",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "RELATION"
            },
            "relation": {
              "type": "string",
              "enum": [
                "EQUALS",
                "LESS_THAN",
                "LESS_THAN_OR_EQUAL",
                "GREATER_THAN",
                "GREATER_THAN_OR_EQUAL"
              ]
            },
            "left": {
              "$ref": "#/$defs/expressionNode"
            },
            "right": {
              "$ref": "#/$defs/expressionNode"
            }
          }
        }
      ]
    }
  },
  "description": "Unverified bounded calculus proposal bound to an authoritative canonical/parse revision. Source obligations remain exclusively in the canonical problem."
}
