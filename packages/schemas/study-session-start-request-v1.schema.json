{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verified-ai.com/study-session-start-request-v1.schema.json",
  "title": "StudySessionStartRequestV1",
  "description": "Start a durable server-orchestrated study session (Sprint 8.7, INV-SESS-001).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_context",
    "topic_code",
    "locale",
    "total_steps",
    "client_instance_id",
    "step_blueprint"
  ],
  "$defs": {
    "stepBlueprintItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_index",
        "step_type",
        "step_title",
        "estimated_seconds",
        "status"
      ],
      "properties": {
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 49
        },
        "step_type": {
          "type": "string",
          "enum": [
            "CONCEPT_PRIMER",
            "MICRO_LESSON",
            "SOLVE_ITEM",
            "VERIFY_STEP",
            "SPACED_RECALL",
            "REFLECTION"
          ]
        },
        "step_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "estimated_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "IN_PROGRESS",
            "COMPLETED",
            "SKIPPED"
          ]
        },
        "target_skill_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "problem_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resumeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_step_index",
        "draft_step_notes",
        "offline_queued_count"
      ],
      "properties": {
        "last_step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "draft_step_notes": {
          "type": "string",
          "maxLength": 2000
        },
        "offline_queued_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "active_sub_step": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "ui_scroll_anchor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "mistake_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "properties": {
    "coach_session_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_context": {
      "type": "string",
      "enum": [
        "DAILY_COACH",
        "SPACED_REVIEW",
        "ADAPTIVE_PRACTICE",
        "MISTAKE_REPAIR",
        "FREE_STUDY"
      ]
    },
    "topic_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "locale": {
      "type": "string",
      "enum": [
        "tr-TR",
        "en-US"
      ]
    },
    "total_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "client_instance_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "step_blueprint": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/stepBlueprintItem"
      }
    },
    "resume_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/resumeSnapshot"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
