{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verified-ai.com/study-session-start-response-v1.schema.json",
  "title": "StudySessionStartResponseV1",
  "description": "Response emitted when starting a durable study session, including prior session auto-pause/expiry outcomes (Sprint 8.7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session",
    "auto_paused_prior_session_id",
    "expired_prior_session_id",
    "training_eligible"
  ],
  "$defs": {
    "stepBlueprintItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_index",
        "step_type",
        "step_title",
        "estimated_seconds",
        "status"
      ],
      "properties": {
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 49
        },
        "step_type": {
          "type": "string",
          "enum": [
            "CONCEPT_PRIMER",
            "MICRO_LESSON",
            "SOLVE_ITEM",
            "VERIFY_STEP",
            "SPACED_RECALL",
            "REFLECTION"
          ]
        },
        "step_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "estimated_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "IN_PROGRESS",
            "COMPLETED",
            "SKIPPED"
          ]
        },
        "target_skill_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "problem_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resumeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_step_index",
        "draft_step_notes",
        "offline_queued_count"
      ],
      "properties": {
        "last_step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "draft_step_notes": {
          "type": "string",
          "maxLength": 2000
        },
        "offline_queued_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "active_sub_step": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "ui_scroll_anchor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "mistake_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "studySessionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "session_id",
        "user_id",
        "coach_session_id",
        "source_context",
        "topic_code",
        "locale",
        "state",
        "total_steps",
        "current_step_index",
        "completed_steps_count",
        "last_sequence_number",
        "active_duration_seconds",
        "paused_duration_seconds",
        "client_instance_id",
        "interruption_reason",
        "step_blueprint",
        "resume_snapshot",
        "started_at",
        "last_checkpoint_at",
        "paused_at",
        "resumed_at",
        "completed_at",
        "expires_at",
        "training_eligible"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "user_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "coach_session_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_context": {
          "type": "string",
          "enum": [
            "DAILY_COACH",
            "SPACED_REVIEW",
            "ADAPTIVE_PRACTICE",
            "MISTAKE_REPAIR",
            "FREE_STUDY"
          ]
        },
        "topic_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locale": {
          "type": "string",
          "enum": [
            "tr-TR",
            "en-US"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "INITIALIZED",
            "ACTIVE",
            "PAUSED",
            "COMPLETED",
            "ABANDONED"
          ]
        },
        "total_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "current_step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "completed_steps_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "last_sequence_number": {
          "type": "integer",
          "minimum": 0
        },
        "active_duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14400
        },
        "paused_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "client_instance_id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        },
        "interruption_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "USER_PAUSED",
                "APP_BACKGROUNDED",
                "NETWORK_LOST",
                "PHONE_CALL",
                "OS_TERMINATED",
                "EXPIRED_INACTIVITY",
                "SUPERSEDED_BY_NEW_SESSION"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "step_blueprint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/stepBlueprintItem"
          }
        },
        "resume_snapshot": {
          "$ref": "#/$defs/resumeSnapshot"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_checkpoint_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "paused_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "training_eligible": {
          "type": "boolean",
          "const": false
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session": {
      "$ref": "#/$defs/studySessionState"
    },
    "auto_paused_prior_session_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expired_prior_session_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "training_eligible": {
      "type": "boolean",
      "const": false
    }
  }
}
