{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verified-ai.com/studyplan/rebalance-response-v1.schema.json",
  "title": "StudyPlanRebalanceResponseV1",
  "description": "Deterministic study plan rebalance receipt contract (Sprint 8.5, INV-REBAL-001..006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rebalance_event_id",
    "user_id",
    "recovery_date",
    "trigger_type",
    "missed_days_count",
    "days_until_exam",
    "previous_daily_budget_minutes",
    "rebalanced_daily_budget_minutes",
    "pruned_tasks_count",
    "rescheduled_reviews_count",
    "active_today_tasks_count",
    "mini_mode_activated",
    "prune_reason_code",
    "pruned_concept_ids",
    "welcome_message_key",
    "idempotent_replay",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "rebalance_event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "recovery_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "MISSED_DAYS",
        "PACE_CHANGE",
        "EXAM_DATE_SHIFT",
        "MANUAL_RESET",
        "MINI_MODE_DOWNSHIFT"
      ]
    },
    "missed_days_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "days_until_exam": {
      "type": "integer",
      "minimum": 1,
      "maximum": 730
    },
    "previous_daily_budget_minutes": {
      "type": "integer",
      "enum": [5, 10, 15, 20, 25]
    },
    "rebalanced_daily_budget_minutes": {
      "type": "integer",
      "enum": [5, 10, 15, 20, 25]
    },
    "pruned_tasks_count": {
      "type": "integer",
      "minimum": 0
    },
    "rescheduled_reviews_count": {
      "type": "integer",
      "minimum": 0
    },
    "active_today_tasks_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "mini_mode_activated": {
      "type": "boolean"
    },
    "prune_reason_code": {
      "type": "string",
      "enum": [
        "NONE",
        "MISSED_DAY_WINDOW_RESET",
        "BUDGET_CEILING_LOW_ROI_PRUNED",
        "DAILY_MISSION_CAP_ENFORCED",
        "MINI_MODE_SINGLE_FOCUS"
      ]
    },
    "pruned_concept_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 128
      }
    },
    "welcome_message_key": {
      "type": "string",
      "pattern": "^studyplan\\.rebalance\\.[a-z0-9_]+$"
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
