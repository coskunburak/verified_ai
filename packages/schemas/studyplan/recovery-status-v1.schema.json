{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verified-ai.com/studyplan/recovery-status-v1.schema.json",
  "title": "StudyPlanRecoveryStatusV1",
  "description": "Deterministic non-punitive missed-day recovery status contract (Sprint 8.5, INV-REBAL-001..006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "as_of_date",
    "recovery_needed",
    "missed_days_count",
    "days_until_exam",
    "previous_daily_budget_minutes",
    "recommended_daily_budget_minutes",
    "mini_mode_recommended",
    "active_today_tasks_count",
    "pruned_tasks_count",
    "rescheduled_reviews_count",
    "prune_reason_code",
    "welcome_message_key",
    "last_rebalance_event_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "as_of_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "recovery_needed": {
      "type": "boolean"
    },
    "missed_days_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "days_until_exam": {
      "type": "integer",
      "minimum": 1,
      "maximum": 730
    },
    "previous_daily_budget_minutes": {
      "type": "integer",
      "enum": [5, 10, 15, 20, 25]
    },
    "recommended_daily_budget_minutes": {
      "type": "integer",
      "enum": [5, 10, 15, 20, 25]
    },
    "mini_mode_recommended": {
      "type": "boolean"
    },
    "active_today_tasks_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "pruned_tasks_count": {
      "type": "integer",
      "minimum": 0
    },
    "rescheduled_reviews_count": {
      "type": "integer",
      "minimum": 0
    },
    "prune_reason_code": {
      "type": "string",
      "enum": [
        "NONE",
        "MISSED_DAY_WINDOW_RESET",
        "BUDGET_CEILING_LOW_ROI_PRUNED",
        "DAILY_MISSION_CAP_ENFORCED",
        "MINI_MODE_SINGLE_FOCUS"
      ]
    },
    "welcome_message_key": {
      "type": "string",
      "pattern": "^studyplan\\.rebalance\\.[a-z0-9_]+$"
    },
    "last_rebalance_event_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
