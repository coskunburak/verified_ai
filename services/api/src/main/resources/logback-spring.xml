<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="environment" source="app.environment" defaultValue="local"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- Log pattern with JSON formatting and automated credential/token redaction -->
      <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","service":"verified-ai-api","environment":"${environment}","traceId":"%X{traceId:-}","correlationId":"%X{correlationId:-}","logger":"%logger{36}","message":"%replace(%replace(%replace(%msg){'(?i)(Bearer\s+)[A-Za-z0-9_\-\.]{10,}','$1[REDACTED]'}){'(?i)(password|secret|token|apikey|api_key|internal_token|access_token)\s*[:=]\s*([^\s,;\"\'\}]+)','$1=[REDACTED]'}){'&quot;','\\&quot;'}"}%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>

